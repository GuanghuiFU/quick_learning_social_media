# 复制本项目为 .env 并填入自己的 key（LLM_API_KEY / ASR_API 可直接沿用 quick_learning/.env 的）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
CLASSIFY_MODEL=deepseek-v4-flash

ASR_PROVIDER=qwen-audio-3.0-asr-flash
ASR_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_API=

VAULT_PATH=/Users/fuguanghui/Documents/Obsidian Vault
NOTES_DIR=小红书学习

OCR_ENGINE=apple
OCR_ESCALATE_MIN_CHARS=40

XHS_FAVORITES_LIMIT=20
XHS_BACKFILL=false
STT_MAX_SEC=1800
CLEAN_DOWNLOADS=true
